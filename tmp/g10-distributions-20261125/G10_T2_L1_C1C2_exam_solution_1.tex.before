$\GTenHLValue{3}$ & $\GTenHLProbability{2/20}$\\
$\GTenHLValue{7}$ & $\GTenHLProbability{3/20}$\\
$\GTenHLValue{11}$ & $\GTenHLProbability{3/20}$\\
$\GTenHLValue{16}$ & $\GTenHLProbability{2/20}$\\
$\GTenHLValue{22}$ & $\GTenHLProbability{4/20}$\\
$\GTenHLValue{34}$ & $\GTenHLProbability{2/20}$\\
\bottomrule\end{tabular}
\end{minipage}\hfill
\begin{minipage}{.70\linewidth}\centering
