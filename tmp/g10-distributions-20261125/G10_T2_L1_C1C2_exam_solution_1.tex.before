\Needspace{8\baselineskip}
\subsection*{Task 3 (c) --- question and worked solution (proposed allocation) \score{1}}
\label{sol:q5t3}

\noindent\textbf{\boldmath Calculate and interpret (i) the probability that the account credit is less than 12 USD and (ii) the probability that it is at least 18 USD.}\par\nopagebreak

\textbf{Allocation:} (i) 0.5 points; (ii) 0.5 points.

\textbf{(i) Less than \GTenHLValue{12 USD}.} Include only the \GTenHLValue{support} values $\GTenHLValue{0},\GTenHLValue{3},\GTenHLValue{7}$; the mass at \GTenHLValue{12 USD} is excluded because the inequality is strict:
\[
P(\GTenHLValue{X}<\GTenHLValue{12})=\GTenHLProbability{p_X(0)}+\GTenHLProbability{p_X(3)}+\GTenHLProbability{p_X(7)}
=\frac{\GTenHLProbability{1}+\GTenHLProbability{2}+\GTenHLProbability{3}}{\GTenHLProbability{20}}=\GTenHLProbability{\frac3{10}}=\GTenHLProbability{0.30}.
\]
For one booking, the \GTenHLValue{account credit} is below \GTenHLValue{12 USD} with probability $\GTenHLProbability{30\%}$.

\textbf{(ii) At least \GTenHLValue{18 USD}.} Include both $\GTenHLValue{18}$ and $\GTenHLValue{27}$; the boundary mass at \GTenHLValue{18 USD} is included:
\[
P(\GTenHLValue{X}\geq\GTenHLValue{18})=\GTenHLProbability{p_X(18)}+\GTenHLProbability{p_X(27)}=\frac{\GTenHLProbability{3}+\GTenHLProbability{5}}{\GTenHLProbability{20}}=\GTenHLProbability{\frac25}=\GTenHLProbability{0.40}.
\]
For one booking, the \GTenHLValue{account credit} is \GTenHLValue{18 USD} or more with probability $\GTenHLProbability{40\%}$.

