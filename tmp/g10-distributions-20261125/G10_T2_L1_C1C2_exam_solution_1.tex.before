\textbf{Question 6 --- continued}\quad\hyperref[sec:q6]{Original description}

\Needspace{8\baselineskip}
\subsection*{Task 3 (c) --- question and worked solution (proposed allocation) \score{1.5}}
\label{sol:q6t3}

\noindent\textbf{\boldmath Calculate and interpret (i) the probability that the final payout is less than 14 USD and (ii) the probability that it is at least 28 USD.}\par\nopagebreak

\textbf{Allocation:} (i) 0.75 points; (ii) 0.75 points.

\textbf{(i) Less than \GTenHLValue{14 USD}.} Include only the final-payout \GTenHLValue{support} values $\GTenHLValue{0},\GTenHLValue{6},\GTenHLValue{12}$; exclude the mass at \GTenHLValue{14 USD} because the inequality is strict:
\[
P(\GTenHLValue{X}<\GTenHLValue{14})=\GTenHLProbability{p_X(0)}+\GTenHLProbability{p_X(6)}+\GTenHLProbability{p_X(12)}
=\frac{\GTenHLProbability{4}+\GTenHLProbability{18}+\GTenHLProbability{12}}{\GTenHLProbability{84}}=\GTenHLProbability{\frac{17}{42}}\approx\GTenHLProbability{0.404762}.
\]
The \GTenHLValue{final payout} for a uniformly selected three-ticket subset is below \GTenHLValue{14 USD} with probability $\GTenHLProbability{17/42}$, approximately $\GTenHLProbability{40.48\%}$.

\textbf{(ii) At least \GTenHLValue{28 USD}.} Include both final payouts $\GTenHLValue{28}$ and $\GTenHLValue{30}$, including the boundary mass at \GTenHLValue{28 USD} and the capped mass at \GTenHLValue{30 USD}:
\[
P(\GTenHLValue{X}\geq\GTenHLValue{28})=\GTenHLProbability{p_X(28)}+\GTenHLProbability{p_X(30)}
=\frac{\GTenHLProbability{28}+\GTenHLProbability{9}}{\GTenHLProbability{84}}=\GTenHLProbability{\frac{37}{84}}\approx\GTenHLProbability{0.440476}.
\]
The \GTenHLValue{final payout} for a uniformly selected three-ticket subset is \GTenHLValue{28 USD} or more with probability $\GTenHLProbability{37/84}$, approximately $\GTenHLProbability{44.05\%}$, after the bonus and cap.

