\CreditDescription{(i): the contextual interpretation} & 0.0625\\
\CreditDescription{(ii): selecting exactly the included PMF masses with the correct boundary} & 0.125\\
\CreditDescription{(ii): summing them correctly} & 0.0625\\
\CreditDescription{(ii): the contextual interpretation} & 0.0625\\
\midrule
\CreditDescription{\textbf{Total}} & \textbf{0.5}\\
\bottomrule\end{tabular}
\end{minipage}\par\smallskip

