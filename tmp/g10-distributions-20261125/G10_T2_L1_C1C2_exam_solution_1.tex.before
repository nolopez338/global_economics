$\GTenHLValue{3}$ & $\GTenHLProbability{2/20}=\GTenHLProbability{1/10}$\\
$\GTenHLValue{7}$ & $\GTenHLProbability{3/20}$\\
$\GTenHLValue{12}$ & $\GTenHLProbability{6/20}=\GTenHLProbability{3/10}$\\
$\GTenHLValue{18}$ & $\GTenHLProbability{3/20}$\\
$\GTenHLValue{27}$ & $\GTenHLProbability{5/20}=\GTenHLProbability{1/4}$\\
\bottomrule\end{tabular}
\end{minipage}\hfill
