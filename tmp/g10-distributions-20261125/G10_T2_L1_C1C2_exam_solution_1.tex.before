\Needspace{5\baselineskip}\textbf{PMF checks.}
\begin{itemize}
\item Nonnegativity: every listed mass is strictly positive.
\item Normalization: $\GTenHLProbability{1}+\GTenHLProbability{2}+\GTenHLProbability{3}+\GTenHLProbability{6}+\GTenHLProbability{3}+\GTenHLProbability{5}=\GTenHLProbability{20}$, so the masses sum to $\GTenHLProbability{20/20}=\GTenHLProbability{1}$.
\item Outside the \GTenHLValue{support}: set $\GTenHLProbability{p_X(x)}=\GTenHLProbability{0}$ there. The graph places bars at the actual monetary values; gaps carry no mass.
\end{itemize}

\textbf{Relationship check.}
\begin{itemize}
\item Likelihood relationships: the numerators satisfy $\GTenHLProbability{2}=2(\GTenHLProbability{1})$, $\GTenHLProbability{3}=\GTenHLProbability{1}+\GTenHLProbability{2}$, $\GTenHLProbability{6}=2(\GTenHLProbability{3})$, $\GTenHLProbability{3}=\GTenHLProbability{6/2}$, and $\GTenHLProbability{5}=\GTenHLProbability{2}+\GTenHLProbability{3}$, exactly reproducing all five verbal relationships.
\end{itemize}

