\[
P(\GTenHLValue{X}<\GTenHLValue{11})=\GTenHLProbability{p_X(0)}+\GTenHLProbability{p_X(3)}+\GTenHLProbability{p_X(7)}
=\frac{\GTenHLProbability{4}+\GTenHLProbability{2}+\GTenHLProbability{3}}{\GTenHLProbability{20}}=\GTenHLProbability{\frac9{20}}=\GTenHLProbability{0.45}.
\]
